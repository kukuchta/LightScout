<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card, Low state: glass fill plus FB7185 12 % tint (visual token, not a range classifier). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/glass_hero" />
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_hero_tint_low" />
            <corners android:radius="@dimen/glass_hero_radius" />
        </shape>
    </item>
</layer-list>
