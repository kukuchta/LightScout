<?xml version="1.0" encoding="utf-8"?>
<!-- Warning chip: FFD0CC text on 632937, FB7185 border at 60 %. Insets keep a 48 dp touch target (R-90). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="@dimen/glass_chip_inset"
    android:insetTop="@dimen/glass_chip_inset">
    <shape android:shape="rectangle">
        <solid android:color="@color/glass_chip_warning_background" />
        <stroke android:width="@dimen/glass_stroke" android:color="@color/glass_chip_warning_border" />
        <corners android:radius="100dp" />
    </shape>
</inset>
