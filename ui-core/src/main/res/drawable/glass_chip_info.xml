<?xml version="1.0" encoding="utf-8"?>
<!-- Info chip: CFFAFE text on 164453, accent border at 44 %. Vertical insets keep a 48 dp touch target (R-90). -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetBottom="@dimen/glass_chip_inset"
    android:insetTop="@dimen/glass_chip_inset">
    <shape android:shape="rectangle">
        <solid android:color="@color/glass_chip_info_background" />
        <stroke android:width="@dimen/glass_stroke" android:color="@color/glass_chip_info_border" />
        <corners android:radius="100dp" />
    </shape>
</inset>
