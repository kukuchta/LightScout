<?xml version="1.0" encoding="utf-8"?>
<!-- Static glass card: white 7 % over the real background, white 14 % border, 18 dp radius (R-90). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/glass_card" />
    <stroke android:width="@dimen/glass_stroke" android:color="@color/glass_card_border" />
    <corners android:radius="@dimen/glass_card_radius" />
</shape>
