<?xml version="1.0" encoding="utf-8"?>
<!-- Hero card, Urgent low state: glass fill plus EF202A 19 % tint, FF6268 60 % border (not a range classifier). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_card" />
            <corners android:radius="@dimen/glass_hero_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_hero_tint_urgent_low" />
            <stroke android:width="@dimen/glass_stroke" android:color="@color/glass_hero_border_urgent_low" />
            <corners android:radius="@dimen/glass_hero_radius" />
        </shape>
    </item>
</layer-list>
