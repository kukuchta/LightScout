<?xml version="1.0" encoding="utf-8"?>
<!--
    Shapes, component styles and typography roles (CMP-30; CP-06 §7.2; GIR-8, GIR-9; M3-12, M3-37; A4).
    No style sets a fixed text height or maxLines, so text grows with font scale 200 % (A4).
-->
<resources>

    <!-- Shapes (DS:D-072): small 8 dp, medium 12 dp (cards), large 16 dp (FAB / sheets), buttons fully rounded. -->
    <style name="ShapeAppearance.LightScout.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.LightScout.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="ShapeAppearance.LightScout.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.LightScout.Full" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <!-- Text fields: Outlined everywhere (DS:D-071, GIR-9). -->
    <style name="Widget.LightScout.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox" />

    <!-- App bar lifts by colour (surface to surfaceContainer), no elevation shadow (M3-37). -->
    <style name="Widget.LightScout.AppBarLayout" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">?attr/colorSurface</item>
        <item name="liftOnScroll">true</item>
        <item name="liftOnScrollColor">?attr/colorSurfaceContainer</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Screen title: Title Large (M3-12). -->
    <style name="Widget.LightScout.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.LightScout.ScreenTitle</item>
    </style>

    <!-- Cards (M3-37): Outlined on surface; Filled on surfaceContainerHighest; medium 12 dp corners. -->
    <style name="Widget.LightScout.CardView.Outlined" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LightScout.Medium</item>
    </style>

    <style name="Widget.LightScout.CardView.Filled" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainerHighest</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LightScout.Medium</item>
    </style>

    <!-- Buttons fully rounded (DS:D-072). -->
    <style name="Widget.LightScout.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.LightScout.Full</item>
    </style>

    <!-- FAB: large 16 dp corners (DS:D-072). -->
    <style name="Widget.LightScout.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.LightScout.Large</item>
    </style>

    <style name="Widget.LightScout.ExtendedFloatingActionButton"
        parent="Widget.Material3.ExtendedFloatingActionButton.Icon.Primary">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.LightScout.Large</item>
    </style>

    <!-- Bottom sheets: large 16 dp top corners (DS:D-072), one solid surface colour (BUG-38). -->
    <style name="Widget.LightScout.BottomSheet.Modal" parent="Widget.Material3.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.LightScout.Large</item>
        <item name="backgroundTint">?attr/colorSurfaceContainer</item>
    </style>

    <!-- Typography roles (CP-06 §7.2 "Typography role usage", M3-12). -->
    <!-- Screen title (toolbar): Title Large. -->
    <style name="TextAppearance.LightScout.ScreenTitle" parent="TextAppearance.Material3.TitleLarge" />
    <!-- Current reading on S-01 and S-09: Display Large. -->
    <style name="TextAppearance.LightScout.CurrentReading" parent="TextAppearance.Material3.DisplayLarge" />
    <!-- Current reading on S-12: Display Small. -->
    <style name="TextAppearance.LightScout.CurrentReading.Widget" parent="TextAppearance.Material3.DisplaySmall" />
    <!-- Alarm title (S-09): Headline Large. -->
    <style name="TextAppearance.LightScout.AlarmTitle" parent="TextAppearance.Material3.HeadlineLarge" />
    <!-- Counters: title Title Small, value Headline Small, status Body Small. -->
    <style name="TextAppearance.LightScout.CounterTitle" parent="TextAppearance.Material3.TitleSmall" />
    <style name="TextAppearance.LightScout.CounterValue" parent="TextAppearance.Material3.HeadlineSmall" />
    <style name="TextAppearance.LightScout.CounterStatus" parent="TextAppearance.Material3.BodySmall" />
    <!-- Doughnut: centre Title Large, legend Body Medium. -->
    <style name="TextAppearance.LightScout.DoughnutCentre" parent="TextAppearance.Material3.TitleLarge" />
    <style name="TextAppearance.LightScout.DoughnutLegend" parent="TextAppearance.Material3.BodyMedium" />
    <!-- Chart labels: Label Small. -->
    <style name="TextAppearance.LightScout.ChartLabel" parent="TextAppearance.Material3.LabelSmall" />
    <!-- Lists: primary Body Large; supporting Body Medium / Body Small. -->
    <style name="TextAppearance.LightScout.ListPrimary" parent="TextAppearance.Material3.BodyLarge" />
    <style name="TextAppearance.LightScout.Supporting" parent="TextAppearance.Material3.BodyMedium" />
    <style name="TextAppearance.LightScout.SupportingSmall" parent="TextAppearance.Material3.BodySmall" />
</resources>
