        app:showAsAction="ifRoom"
        app:tooltipText="@string/s01_action_statistics_cd" />
    <item
        android:id="@+id/s01_action_settings"
        android:icon="@drawable/ic_s01_settings"
        android:title="@string/s01_action_settings"
        app:contentDescription="@string/s01_action_settings_cd"
        app:showAsAction="ifRoom"
        app:tooltipText="@string/s01_action_settings_cd" />
