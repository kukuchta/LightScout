    long-press tooltip „Open statistics” / „Open settings”). No alarms toggle (DS:D-067).
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item
        android:id="@+id/s01_action_support"
        android:icon="@drawable/ic_s01_support"
