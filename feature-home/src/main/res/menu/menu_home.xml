        app:showAsAction="ifRoom"
        app:tooltipText="@string/s01_action_support_cd" />
    <item
        android:id="@+id/s01_action_statistics"
        android:icon="@drawable/ic_s01_statistics"
        android:title="@string/s01_action_statistics"
