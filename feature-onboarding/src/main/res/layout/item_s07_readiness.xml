<?xml version="1.0" encoding="utf-8"?>
<!--
    One C-S07-04 checklist item (CP-14 §7.4.2): leading status icon (✓ primary / ! error / ↗ onSurfaceVariant — M3-29),
    headline, supporting text (rationale, „Done” or „Turned off in system settings”), inline M3-30 error (error role,
    live region) and the tonal action button below the supporting text, start-aligned (M3-31). The text block is one
    accessibility unit read status first; the button is a separate focus stop.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/s07_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_s07_status_attention" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/s07_item_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/s07_item_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.LightScout.ListPrimary"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/s07_item_supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:textAppearance="@style/TextAppearance.LightScout.Supporting"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/s07_item_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:accessibilityLiveRegion="polite"
            android:text="@string/s07_error_open_setting"
            android:textAppearance="@style/TextAppearance.LightScout.Supporting"
            android:textColor="?attr/colorError"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/s07_item_action"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>
