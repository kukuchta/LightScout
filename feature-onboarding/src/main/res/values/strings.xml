    <!-- S-07 Alarm readiness -->
    <string name="s07_title">Alarm readiness</string>
    <string name="s07_item_notifications">Notifications</string>
    <string name="s07_item_notifications_rationale">Needed to show alarms and the current reading.</string>
    <string name="s07_item_dnd">Alarms during Do Not Disturb</string>
    <string name="s07_item_dnd_rationale">Lets urgent alarms ring even when Do Not Disturb is on.</string>
    <string name="s07_item_full_screen">Full-screen alarms</string>
    <string name="s07_item_full_screen_rationale">Shows the alarm over the lock screen so you can snooze without unlocking.</string>
    <string name="s07_item_battery">Battery optimisation</string>
    <string name="s07_item_battery_rationale">Stops Android from pausing LightScout in the background.</string>
