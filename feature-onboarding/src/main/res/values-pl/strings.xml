    <!-- S-07 Alarm readiness -->
    <string name="s07_title">Gotowość alarmów</string>
    <string name="s07_item_notifications">Powiadomienia</string>
    <string name="s07_item_notifications_rationale">Wymagane do wyświetlania alarmów i bieżącego odczytu.</string>
    <string name="s07_item_dnd">Alarmy w trybie Nie przeszkadzać</string>
